{
  "name": "fennec-vox",
  "version": "1.0.0",
  "description": "EPUB/PDF to audiobook — Electron desktop app + CLI",
  "main": "out/main/index.js",
  "packageManager": "pnpm@10.33.0",
  "bin": {
    "fennec-vox": "./dist/cli/convert.js"
  },
  "scripts": {
    "dev": "pnpm run build-cli && electron-vite dev",
    "build": "electron-vite build",
    "build-cli": "tsc -p tsconfig.cli.json",
    "build:all": "pnpm run build && pnpm run build-cli",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.cli.json",
    "package": "pnpm run build:all && electron-builder --mac"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "cheerio": "^1.0.0",
    "epub": "^1.2.0",
    "fs-extra": "^11.2.0",
    "keytar": "^7.9.0",
    "openai": "^4.67.0",
    "pdf-parse": "^1.1.1",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.0.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/yargs": "^17.0.33",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2",
    "electron-vite": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["electron", "esbuild", "keytar"]
  },
  "build": {
    "appId": "com.fennecvox.app",
    "productName": "Fennec Vox",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
      "protocols": [{ "name": "Fennec Vox", "schemes": ["fennecvox"] }]
    },
    "extraResources": [
      {
        "from": "./dist/cli/convert.js",
        "to": "convert.js"
      }
    ]
  }
}
