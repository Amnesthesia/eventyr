---
import "@react/pico.scss";
import "@react/styles.css";
import type { CityData } from "@react/types";
import { KEY_TO_SLUG } from "@react/utils/citySlug";
import { catToSlug, catShortName } from "@react/utils/categorySlug";
import {
	costLabel,
	DEFAULT_COST_LOCALE,
	eventPath,
	isLikelyImageUrl,
	isoWithOffset,
	stripForDisplay,
} from "../shared.ts";

interface Props {
	cityData: CityData;
	slug: string;
	canonical?: string;
	categorySlug?: string;
	categoryLabel?: string;
	cityCategories?: string[];
	/**
	 * Overrides for a page that is about one thing rather than about a city.
	 * An event page has to set these: the share preview a recipient sees in
	 * WhatsApp or Slack is built entirely from og:title/og:description, so
	 * inheriting the city's copy would defeat the point of having the page.
	 */
	title?: string;
	description?: string;
	ogType?: string;
	schema?: unknown;
	/** Absolute URL of a preview image for this page specifically. An event
	 * page passes its own image where the source gave one: an unfurl showing
	 * the actual event beats the site's generic card. */
	ogImage?: string;
}

const {
	cityData,
	slug,
	canonical,
	categorySlug,
	categoryLabel,
	cityCategories,
	title: titleOverride,
	description: descriptionOverride,
	ogType = "website",
	schema: schemaOverride,
	ogImage,
} = Astro.props;
const BASE_URL = "https://www.dothings.lol";

// Trailing slashes: the slash-less form 301s on GitHub Pages, and a canonical
// that points at a redirect is a canonical Google has to resolve rather than
// trust.
const cityUrl =
	canonical ??
	(categorySlug
		? `${BASE_URL}/${slug}/${categorySlug}/`
		: `${BASE_URL}/${slug}/`);
const cityName = cityData.city.split(",")[0];
/** Per-city RSS, so a reader (and a crawler) can discover the feed from any
 * page of that city rather than only by guessing the URL. */
const feedUrl = `${BASE_URL}/${slug}/feed.xml`;

/** "3–13 Sep" — a freshness signal in the description, and the thing a reader
 * actually wants to know from a search result. Hand-formatted rather than via
 * toLocaleDateString: ICU differs between builds ("Sep" vs "Sept") and this
 * string is rendered into committed HTML. */
const MONTHS_SHORT = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
function shortDate(iso: string): string {
	const d = new Date(`${iso}T00:00:00Z`);
	if (Number.isNaN(d.getTime())) return "";
	return `${d.getUTCDate()} ${MONTHS_SHORT[d.getUTCMonth()]}`;
}
// Derived from the events, not from week_start/week_end. Those describe the
// digest week — "31 Aug – 6 Sep" on a page built on 3 September, advertising
// dates already in the past. The build date through the last event's date is
// what the page actually covers, and it is stable for the life of the build.
const eventDates = cityData.events
	.map((e: { datetime_iso?: string }) => (e.datetime_iso ?? "").slice(0, 10))
	.filter(Boolean)
	.sort();
const coverageFrom = cityData.generated_at || cityData.week_start;
const coverageTo = eventDates[eventDates.length - 1] || cityData.week_end;
const coverage =
	coverageFrom && coverageTo && coverageFrom <= coverageTo
		? [coverageFrom, coverageTo].map(shortDate).filter(Boolean).join(" – ")
		: "";

const ogTitle = titleOverride
	? `${titleOverride} — dothings.lol`
	: categoryLabel
	? `${catShortName(categoryLabel)} events in ${cityData.city} this week — dothings.lol`
	: `Things to do in ${cityData.city} this week — dothings.lol`;

// Kept under ~155 characters so Google shows the whole thing rather than
// truncating mid-sentence, and front-loaded with the count, the city and the
// dates — the three facts that decide whether the result gets clicked.
const desc = descriptionOverride
	? descriptionOverride
	: categoryLabel
	? `${cityData.events.length} ${catShortName(categoryLabel).toLowerCase()} events in ${cityName}${coverage ? `, ${coverage}` : ""}. Curated and ranked from local sources, updated weekly.`
	: `${cityData.events.length} things to do in ${cityName}${coverage ? `, ${coverage}` : ""} — live music, workshops, markets, talks and art. Curated weekly from local sources.`;

const availableCategories = (cityCategories ??
	[...new Set(cityData.events.map((e: { category: string }) => e.category))])
	.map((label: string) => ({ catSlug: catToSlug(label), label: catShortName(label) }))
	.filter((c) => c.catSlug)
	.sort((a, b) => a.label.localeCompare(b.label));

const timezone = cityData.timezone ?? "Australia/Brisbane";
const costLocale = {
	locale: cityData.locale ?? DEFAULT_COST_LOCALE.locale,
	currency: cityData.currency ?? DEFAULT_COST_LOCALE.currency,
};

const listed = cityData.events.slice(0, 20);
const schema = {
	"@context": "https://schema.org",
	"@type": "ItemList",
	name: `Events in ${cityData.city}${coverage ? `, ${coverage}` : ""}`,
	numberOfItems: listed.length,
	itemListElement: listed.map((event, index) => ({
		"@type": "ListItem",
		position: index + 1,
		item: {
			"@type": "Event",
			name: stripForDisplay(event.title),
			description: stripForDisplay(event.description) || undefined,
			// With the city's UTC offset: a bare "2026-09-05T19:30:00" is
			// ambiguous and a crawler may read it as UTC, which moves a 7:30pm
			// gig to 5:30am the next day in a rich result.
			startDate: isoWithOffset(event.datetime_iso, timezone),
			endDate: isoWithOffset(event.datetime_end_iso, timezone),
			// Google's Event rich results want an address, not just a venue name.
			location: event.location
				? {
						"@type": "Place",
						name: event.location,
						address: {
							"@type": "PostalAddress",
							addressLocality: cityName,
							addressRegion: "QLD",
							addressCountry: "AU",
						},
					}
				: undefined,
			image: isLikelyImageUrl(event.image) ? event.image : undefined,
			// Our own page for the event, not the source's: it is canonical, it
			// always exists, and it links the list to pages we publish.
			url: `${BASE_URL}${eventPath(cityData.city_key, event)}`,
			eventStatus: "https://schema.org/EventScheduled",
			eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
			organizer: event.source
				? { "@type": "Organization", name: event.source }
				: undefined,
			offers: costLabel(event.cost, costLocale)
				? {
						"@type": "Offer",
						description: costLabel(event.cost, costLocale),
						priceCurrency: costLocale.currency,
						availability: "https://schema.org/InStock",
						url: `${BASE_URL}${eventPath(cityData.city_key, event)}`,
					}
				: undefined,
		},
	})),
};

/** SERP breadcrumbs, and it tells Google the site's shape. */
const breadcrumbs = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{ "@type": "ListItem", position: 1, name: "do things", item: `${BASE_URL}/` },
		{ "@type": "ListItem", position: 2, name: cityName, item: `${BASE_URL}/${slug}/` },
		...(categoryLabel && categorySlug
			? [
					{
						"@type": "ListItem",
						position: 3,
						name: catShortName(categoryLabel),
						item: `${BASE_URL}/${slug}/${categorySlug}/`,
					},
				]
			: []),
		...(titleOverride
			? [{ "@type": "ListItem", position: 3, name: titleOverride, item: cityUrl }]
			: []),
	],
};

const websiteSchema = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: "do things",
	url: "https://www.dothings.lol/",
	description:
		"Weekly curated events guide for Brisbane, Gold Coast and Sunshine Coast",
	keywords:
		"Brisbane events, Gold Coast events, Sunshine Coast events, Goldie, Sunny Coast, AI-curated events, Claude, Gemini, Perplexity, ChatGPT, Things to do in Brisbane, Things to do on the Gold Coast, Things to do on the Sunshine Coast, What's on in Brisbane, What's on on the Gold Coast, What's on on the Sunshine Coast, South East Queensland events, SEQ events",
};
---

<!doctype html>
<html lang="en-AU" data-theme="auto">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{ogTitle}</title>
    <meta name="description" content={desc} />
    <meta
      name="keywords"
      content={`things to do in ${cityName}, ${cityName} events, what's on ${cityName}, events this week`}

    <!--
      max-image-preview:large is the one that matters: without it Google shows
      a thumbnail or nothing for these pages, and the event images are the
      reason to click. The -1s remove Google's own length caps on snippets and
      video previews rather than accepting the defaults.
    -->
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <link rel="canonical" href={cityUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="do things" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={cityUrl} />
    <meta
      property="og:image"
      content={ogImage ?? `${BASE_URL}/dothings-preview-dark.png`}
    />
    <!-- Dimensions let a scraper lay the card out before the image loads, and
         some (Slack, LinkedIn) skip an image with no declared size. Only for
         our own card, whose size we know — an event's hotlinked image could be
         anything. -->
    {!ogImage && <meta property="og:image:width" content="1200" />}
    {!ogImage && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={ogTitle} />
    <meta property="og:locale" content="en_AU" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={desc} />
    <meta
      name="twitter:image"
      content={ogImage ?? `${BASE_URL}/dothings-preview.jpg`}
    />
    <meta name="twitter:image:alt" content={ogTitle} />
    <!-- Was #1a1a2e, a colour that appears nowhere in the palette. These are
         --bg for each scheme, so the browser chrome matches the page. -->
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0b0b" media="(prefers-color-scheme: dark)" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`Events in ${cityName} — dothings.lol`}
      href={feedUrl}
    />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.ico" />
    <script type="application/ld+json" set:html={JSON.stringify(schemaOverride ?? schema)} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(websiteSchema)}
    />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} />
    <script
      src="https://app.rybbit.io/api/script.js"
      data-site-id="0f3ec51f30bf"
      defer></script>
    <script
      data-name="BMC-Widget"
      data-cfasync="false"
      src="https://cdnjs.buymeacoffee.com/1.0.0/widget.prod.min.js"
      data-id="amnesthesia"
      data-description="Support me on Buy me a coffee!"
      data-message="Like this project? Buy me a coffee!"
      data-position="Right"
      data-x_margin="18"
      data-color="#aaa"
      data-y_margin="18"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      const t = localStorage.getItem("theme");
      if (t) document.documentElement.setAttribute("data-theme", t);
      // Both of these run BEFORE the body paints, which is the whole point.
      // The intro used to be hidden by React in a useEffect — i.e. after
      // hydration — so a returning visitor saw it render and then vanish.
      // Moving the decision here removes the flicker; a cookie would not have,
      // because document.cookie is read from JS at the same late moment
      // localStorage is. Blocking and inline is what makes it early.
      if (localStorage.getItem("hideCityIntro") === "true")
        document.documentElement.classList.add("intro-hidden");
    </script>
  </head>
  <body>
    <slot />
    <nav class="category-nav" aria-label="Browse by category">
      {availableCategories.map(({ catSlug, label }) => (
        <a
          href={`/${slug}/${catSlug}`}
          class={categorySlug === catSlug ? "filter-btn active" : "filter-btn"}
        >
          {label}
        </a>
      ))}
    </nav>
    <footer class="site-footer">
      <nav>
        <a href="/brisbane">Things to do in Brisbane</a>
        <a href="/gold-coast">Things to do on the Gold Coast</a>
        <a href="/sunshine-coast">Things to do on the Sunshine Coast</a>
      </nav>
      <small>AI-curated events guide for South East Queensland &middot; <a href="/llms.txt">llms.txt</a></small>
    </footer>
  </body>
</html>
