---
import "@react/pico.scss";
import "@react/styles.css";
---

<html lang="en" data-theme="auto">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Not found — do things</title>
    <meta name="robots" content="noindex" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      const t = localStorage.getItem("theme");
      if (t) document.documentElement.setAttribute("data-theme", t);
    </script>
  </head>
  <body>
    <header>
      <a href="/" class="site-name">&gt;&nbsp;do things</a>
      <div class="header-controls">
        <a href="/brisbane/" class="filter-btn">Brisbane</a>
        <a href="/gold-coast/" class="filter-btn">Gold Coast</a>
        <a href="/sunshine-coast/" class="filter-btn">Sunshine Coast</a>
      </div>
    </header>
    <main>
      <div class="not-found">
        <span class="not-found-code">404</span>
        <h2>Nothing here.</h2>
        <p>This page doesn't exist. Pick a city and find something to do:</p>
        <nav class="not-found-nav">
          <a href="/brisbane/" class="filter-btn active">Brisbane</a>
          <a href="/gold-coast/" class="filter-btn active">Gold Coast</a>
          <a href="/sunshine-coast/" class="filter-btn active">Sunshine Coast</a>
        </nav>
      </div>
    </main>
  </body>
</html>

<style is:global>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 4rem 0 2rem;
    gap: 0.6rem;
  }

  .not-found-code {
    font-family: var(--mono);
    font-size: 5rem;
    font-weight: 700;
    line-height: 1;
    color: var(--border);
    letter-spacing: -0.04em;
    margin: 0 0 0.5rem;
  }

  .not-found h2 {
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    margin: 0;
    color: var(--fg);
  }

  .not-found p {
    font-size: 0.85rem;
    color: var(--muted);
    margin: 0;
  }

  .not-found-nav {
    display: flex;
    gap: 0.5rem;
    margin-top: 1rem;
    flex-wrap: wrap;
  }

  .not-found-nav .filter-btn {
    text-decoration: none;
    font-size: 0.72rem;
    height: auto;
    padding: 0.35rem 0.8rem;
  }
</style>
