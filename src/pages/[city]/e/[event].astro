---
// One page per event, so an event can be shared as a link that means something.
//
// Pre-rendered rather than resolved client-side, because the value of a share
// link is mostly the preview WhatsApp/iMessage/Slack build from og:title and
// og:description — and those crawlers run no JavaScript. A link that needed
// the React app to work out which event was meant would unfurl as the generic
// city page, which defeats the purpose.
//
// Deliberately no client:load island: this is one event, so it is plain static
// HTML and works with JavaScript disabled.
import { Fragment } from "astro/jsx-runtime";
import { readFileSync } from "node:fs";
import { join } from "node:path";
import Base from "../../../layouts/Base.astro";
import type { CityData, CityIndex, Event } from "@react/types";
import { SLUG_TO_KEY } from "@react/utils/citySlug";
import { catShortName, catToSlug } from "@react/utils/categorySlug";
import {
	costAmount,
	costLabel,
	DEFAULT_COST_LOCALE,
	eventSlug,
	isLikelyImageUrl,
	isoWithOffset,
	stripForDisplay,
} from "../../../shared.ts";
import { VIBE_LABELS, vibesOf } from "@react/utils/vibes";

export function getStaticPaths() {
	const index: CityIndex = JSON.parse(
		readFileSync(join(process.cwd(), "data/index.json"), "utf-8"),
	);

	return index.cities.flatMap((city) => {
		const slug =
			Object.entries(SLUG_TO_KEY).find(([, k]) => k === city.key)?.[0] ??
			city.key;
		const cityData: CityData = JSON.parse(
			readFileSync(join(process.cwd(), `data/${city.key}.json`), "utf-8"),
		);
		return cityData.events.map((event) => ({
			params: { city: slug, event: eventSlug(city.key, event) },
			props: { cityData, event, cityKey: city.key },
		}));
	});
}

const { cityData, event, cityKey } = Astro.props;
const slug = Astro.params.city as string;
const BASE_URL = "https://www.dothings.lol";
const url = `${BASE_URL}/${slug}/e/${Astro.params.event}/`;
const catSlug = catToSlug(event.category);

// Stripped at render, not in the pipeline: the data keeps the URL because a
// description is often the only place a ticket link appears.
const title = stripForDisplay(event.title);
const eventDescription = stripForDisplay(event.description);
// null when the value names neither a price nor "free"; the row is dropped
// rather than shown as "Cost — See link".
const cost = costLabel(event.cost, {
	locale: cityData.locale ?? DEFAULT_COST_LOCALE.locale,
	currency: cityData.currency ?? DEFAULT_COST_LOCALE.currency,
});

// What the recipient of a shared link actually sees. Front-loads the facts
// they need to decide whether to go: what, when, where.
const shareDescription = [event.datetime, event.location, cost]
	.filter((part) => part && part !== "—")
	.join(" · ");
const description = [shareDescription, eventDescription]
	.filter(Boolean)
	.join(" — ")
	.slice(0, 300);

// Checked here as well as in curate, so already-published data is fixed
// without re-running the pipeline. 61 of 139 scraped image URLs were dead —
// see isLikelyImageUrl for the measurement and the rule.
const ogImage = isLikelyImageUrl(event.image) ? event.image : undefined;

const timezone = cityData.timezone ?? "Australia/Brisbane";
const cityName = cityData.city.split(",")[0];

const schema = {
	"@context": "https://schema.org",
	"@type": "Event",
	name: title,
	description: eventDescription || undefined,
	// With the city's UTC offset. A bare "2026-09-05T19:30:00" is ambiguous and
	// a crawler may read it as UTC, putting a 7:30pm gig at 5:30am the next day
	// in the rich result.
	startDate: isoWithOffset(event.datetime_iso, timezone),
	endDate: isoWithOffset(event.datetime_end_iso, timezone),
	// Google's Event rich results want a postal address, not just a venue
	// name. The suburb is usually inside event.location, so the locality is the
	// city and the venue name carries the rest.
	location: event.location
		? {
				"@type": "Place",
				name: event.location,
				address: {
					"@type": "PostalAddress",
					streetAddress: event.location,
					addressLocality: cityName,
					addressRegion: "QLD",
					addressCountry: "AU",
				},
			}
		: undefined,
	image: ogImage ? [ogImage] : undefined,
	url,
	eventStatus: "https://schema.org/EventScheduled",
	eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
	organizer: event.source
		? { "@type": "Organization", name: event.source }
		: undefined,
	offers: cost
		? {
				"@type": "Offer",
				description: cost,
				priceCurrency: cityData.currency ?? DEFAULT_COST_LOCALE.currency,
				price: costAmount(event.cost) ?? undefined,
				availability: "https://schema.org/InStock",
				url: event.link || url,
			}
		: undefined,
	isAccessibleForFree: cost === "free" || undefined,
};

const vibes = vibesOf(event as Event);

---

<Base
  cityData={cityData}
  slug={slug}
  canonical={url}
  title={title}
  description={description}
  ogType="article"
  schema={schema}
  ogImage={ogImage}
>
  <main class="event-page">
    <nav class="event-crumbs" aria-label="Breadcrumb">
      <a href={`/${slug}/`}>{cityData.city.split(",")[0]}</a>
      <span aria-hidden="true">/</span>
      <a href={`/${slug}/${catSlug}/`}>{catShortName(event.category)}</a>
    </nav>

    <article class="event-detail" data-cat={catSlug}>
      <h1>{title}</h1>

      {ogImage && (
        <img
          class="event-image"
          src={ogImage}
          alt={title}
          loading="lazy"
          decoding="async"
          referrerpolicy="no-referrer"
          {/* The extension check catches today's broken URLs, but these are
              hotlinks to other people's servers and will rot. Removing the
              element beats a broken-image placeholder, and an inline handler
              works in the static HTML with no island. */}
          onerror="this.remove()"
        />
      )}

      <dl class="event-facts">
        <dt>When</dt>
        <dd>{event.datetime || "Date to be confirmed"}</dd>
        <dt>Where</dt>
        <dd>
          {event.location_url ? (
            <a href={event.location_url} target="_blank" rel="noopener">
              {event.location || "—"}
            </a>
          ) : (
            event.location || "—"
          )}
        </dd>
        {cost && (
          <Fragment>
            <dt>Cost</dt>
            <dd>{cost}</dd>
          </Fragment>
        )}
        <dt>Source</dt>
        <dd>{event.source}</dd>
      </dl>

      {eventDescription && (
        <p class="event-description">{eventDescription}</p>
      )}

      {vibes.length > 0 && (
        <ul class="event-vibes">
          {vibes.map((key) => (
            <li class="tag tag-vibe" data-vibe={key}>{VIBE_LABELS[key]}</li>
          ))}
        </ul>
      )}

      <div class="event-actions">
        {event.link && (
          <a class="filter-btn" href={event.link} target="_blank" rel="noopener">
            Event website
          </a>
        )}
        {/*
          Plain markup wired by the module script below, NOT React islands.
          Two client:visible islands here each hydrated their own React root on
          a page that is otherwise static, which is what produced "Invalid hook
          call" — and the page never needed React at all.

          The share control stays an anchor to this page's own URL, so with no
          JavaScript it is still a working link a reader can copy.
        */}
        <button type="button" class="filter-btn" data-action="calendar" hidden>
          Add to calendar
        </button>
        <a class="filter-btn" data-action="share" href={url}>Share</a>
      </div>

      <script
        type="application/json"
        data-event-json
        set:html={JSON.stringify({
          cityKey,
          event: {
            title,
            datetime_iso: event.datetime_iso,
            datetime_end_iso: event.datetime_end_iso,
            location: event.location,
            description: eventDescription,
            link: event.link,
          },
        })}
      />

      <p class="event-back">
        <a href={`/${slug}/`}>← Everything on in {cityData.city.split(",")[0]} this week</a>
      </p>
    </article>
  </main>
</Base>

<script>
  // No framework: these two buttons are the only interactive things on the
  // page, and both helpers are React-free.
  import { downloadEventIcs, buildEventIcs } from "@react/utils/ics";
  import { shareEvent } from "@react/utils/share";

  const holder = document.querySelector("[data-event-json]");
  if (holder?.textContent) {
    const { event, cityKey } = JSON.parse(holder.textContent);

    const calendar = document.querySelector("[data-action='calendar']");
    // Revealed only once we know an .ics can actually be produced — an event
    // with no parsable date would otherwise offer a broken download.
    if (calendar && buildEventIcs(event, cityKey)) {
      calendar.hidden = false;
      calendar.addEventListener("click", () => downloadEventIcs(event, cityKey));
    }

    const share = document.querySelector("[data-action='share']");
    share?.addEventListener("click", async (e) => {
      // Let a modified click open the link normally, as any anchor would.
      if (e.metaKey || e.ctrlKey || e.shiftKey) return;
      e.preventDefault();
      const outcome = await shareEvent(event, cityKey);
      if (outcome === "copied") {
        const previous = share.textContent;
        share.textContent = "Copied";
        setTimeout(() => {
          share.textContent = previous;
        }, 2000);
      } else if (outcome === "failed") {
        window.location.href = share.getAttribute("href");
      }
    });
  }
</script>
