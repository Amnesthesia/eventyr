---
import { readFileSync } from "node:fs";
import { join } from "node:path";
import Base from "../layouts/Base.astro";
import EventApp from "@react/EventApp";
import type { CityData, CityIndex } from "@react/types";

const index: CityIndex = JSON.parse(
	readFileSync(join(process.cwd(), "data/index.json"), "utf-8"),
);
const cityData: CityData = JSON.parse(
	readFileSync(join(process.cwd(), "data/brisbane.json"), "utf-8"),
);
cityData.events.sort((a, b) => (b.score ?? 0) - (a.score ?? 0));
---

<Base cityData={cityData} slug="brisbane" canonical="https://www.dothings.lol/">
  <EventApp client:load cityData={cityData} allCities={index.cities} />
</Base>
