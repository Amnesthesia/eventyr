{
  "name": "epub-to-audiobook",
  "version": "1.0.0",
  "description": "Convert EPUB files to narrated audiobooks using Claude Haiku (SSML) + OpenAI TTS",
  "type": "commonjs",
  "main": "dist/convert.js",
  "bin": {
    "epub-to-audiobook": "./dist/convert.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "tsx convert.ts",
    "dev": "tsx --watch convert.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "cheerio": "^1.0.0",
    "epub": "^1.2.0",
    "fs-extra": "^11.2.0",
    "openai": "^4.67.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.0.0",
    "@types/yargs": "^17.0.33",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
