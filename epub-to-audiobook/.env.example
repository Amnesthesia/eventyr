# Required
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Optional defaults (can also be set via CLI flags)
TTS_VOICE=alloy          # alloy | echo | fable | onyx | nova | shimmer
TTS_FORMAT=mp3           # mp3 | opus | aac | flac
TTS_MODEL=tts-1          # tts-1 | tts-1-hd
CHUNK_SIZE=2000          # characters per Claude SSML chunk
OUTPUT_DIR=./audiobook-output
