{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "composite": true,
    "types": ["node"]
  },
  "include": ["src"],
  // src/pages and src/layouts belong to the Astro app, not the pipeline: they
  // use the @react alias and DOM lib, neither of which this config has. They
  // are typechecked by tsconfig.json, which includes them.
  "exclude": ["src/pages", "src/layouts"]
}
