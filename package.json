{
  "name": "eventyr",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @dothingslol/web dev",
    "build": "pnpm --filter @dothingslol/web build",
    "preview": "pnpm --filter @dothingslol/web preview",
    "prepare": "node ./scripts/setup-hooks.mjs",
    "collect": "pnpm --filter @dothingslol/pipeline collect",
    "collect-adapters": "pnpm --filter @dothingslol/pipeline collect-adapters",
    "curate": "pnpm --filter @dothingslol/pipeline curate",
    "venues": "pnpm --filter @dothingslol/pipeline venues",
    "rank": "pnpm --filter @dothingslol/pipeline rank",
    "dedupe-venues": "pnpm --filter @dothingslol/pipeline dedupe-venues",
    "geocode": "pnpm --filter @dothingslol/pipeline geocode",
    "markdown": "pnpm --filter @dothingslol/pipeline markdown",
    "ical": "pnpm --filter @dothingslol/pipeline ical",
    "rss": "pnpm --filter @dothingslol/pipeline rss",
    "pages": "pnpm --filter @dothingslol/pipeline pages",
    "build-ai": "pnpm --filter @dothingslol/pipeline build-ai",
    "add-city": "pnpm --filter @dothingslol/pipeline add-city",
    "probe-sources": "pnpm --filter @dothingslol/pipeline probe-sources",
    "discover-sources": "pnpm --filter @dothingslol/pipeline discover-sources",
    "test-adapter": "pnpm --filter @dothingslol/pipeline test-adapter",
    "test:pipeline": "pnpm --filter @dothingslol/pipeline test",
    "test:app": "pnpm --filter @dothingslol/web test",
    "check": "pnpm -r typecheck && biome check apps packages scripts && pnpm -r test && node scripts/check-boundaries.mjs",
    "render-sources": "pnpm --filter @dothingslol/pipeline render-sources",
    "triage": "pnpm --filter @dothingslol/pipeline triage"
  },
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "typescript": "catalog:"
  }
}