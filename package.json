{
  "name": "eventyr",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @dothingslol/web dev",
    "build": "pnpm --filter @dothingslol/web build",
    "preview": "pnpm --filter @dothingslol/web preview",
    "prepare": "node ./scripts/setup-hooks.mjs",
    "collect": "tsx --env-file-if-exists=.env --tsconfig tsconfig.scripts.json src/collection.ts",
    "collect-adapters": "tsx --env-file-if-exists=.env --tsconfig tsconfig.scripts.json src/adapters/collect.ts",
    "curate": "tsx --env-file-if-exists=.env --tsconfig tsconfig.scripts.json src/curate.ts",
    "venues": "tsx --env-file-if-exists=.env --tsconfig tsconfig.scripts.json src/venues.ts",
    "rank": "tsx --env-file-if-exists=.env --tsconfig tsconfig.scripts.json src/rank.ts",
    "dedupe-venues": "tsx --tsconfig tsconfig.scripts.json src/venues.ts",
    "geocode": "tsx --env-file-if-exists=.env --tsconfig tsconfig.scripts.json src/geocode.ts",
    "markdown": "tsx --env-file-if-exists=.env --tsconfig tsconfig.scripts.json src/markdown.ts",
    "ical": "tsx --env-file-if-exists=.env --tsconfig tsconfig.scripts.json src/ical.ts",
    "rss": "tsx --env-file-if-exists=.env --tsconfig tsconfig.scripts.json src/rss.ts",
    "pages": "tsx --env-file-if-exists=.env --tsconfig tsconfig.scripts.json src/pages.ts",
    "build-ai": "tsx --env-file-if-exists=.env --tsconfig tsconfig.scripts.json src/ai.ts",
    "add-city": "tsx --env-file-if-exists=.env --tsconfig tsconfig.scripts.json src/add_city.ts",
    "probe-sources": "tsx --env-file-if-exists=.env --tsconfig tsconfig.scripts.json src/adapters/probe.ts",
    "discover-sources": "tsx --env-file-if-exists=.env --tsconfig tsconfig.scripts.json src/adapters/discover.ts",
    "test-adapter": "tsx --env-file-if-exists=.env --tsconfig tsconfig.scripts.json src/adapters/testUrl.ts",
    "test:pipeline": "tsx --tsconfig tsconfig.scripts.json --test 'src/**/*.test.ts'",
    "test:app": "pnpm --filter @dothingslol/web test",
    "test": "pnpm test:pipeline && pnpm test:app",
    "check": "pnpm --filter @dothingslol/web typecheck && tsc --noEmit -p tsconfig.scripts.json && biome check src apps/web/app packages && pnpm test && pnpm -r --filter \"./packages/*\" typecheck && pnpm -r --filter \"./packages/*\" test && node scripts/check-boundaries.mjs",
    "render-sources": "tsx --env-file-if-exists=.env --tsconfig tsconfig.scripts.json src/adapters/render.ts"
  },
  "dependencies": {
    "@dothingslol/core": "workspace:*",
    "@dothingslol/llm": "workspace:*",
    "@dothingslol/scraper": "workspace:*",
    "@dothingslol/utils": "workspace:*",
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.8.0",
    "playwright": "^1.63.0",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}