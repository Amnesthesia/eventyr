{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"isolatedModules": true,
		"moduleDetection": "force",
		"types": ["@cloudflare/workers-types"]
	},
	"include": ["src"],
	"exclude": ["src/**/*.test.ts"]
}
