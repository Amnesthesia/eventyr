---
import { DATA_ROOT } from "../../lib/paths.ts";
import { readFileSync } from "node:fs";
import { join } from "node:path";
import Base from "../../layouts/Base.astro";
import EventApp from "@react/EventApp";
import type { CityData, CityIndex } from "@dothingslol/core/schema";
import {
	byScoreThenSoonest,
	catToSlug,
	SLUG_TO_KEY,
} from "@dothingslol/core/shared";

export function getStaticPaths() {
	const index: CityIndex = JSON.parse(
		readFileSync(join(DATA_ROOT, "/index.json"), "utf-8"),
	);

	const paths = [];

	for (const city of index.cities) {
		const citySlug =
			Object.entries(SLUG_TO_KEY).find(([, k]) => k === city.key)?.[0] ??
			city.key;

		const cityData: CityData = JSON.parse(
			readFileSync(join(DATA_ROOT, `/${city.key}.json`), "utf-8"),
		);

		const presentCats = new Set(cityData.events.map((e) => e.category));

		const cityCategories = [...presentCats];

		for (const catLabel of presentCats) {
			const catSlug = catToSlug(catLabel);

			const filteredData: CityData = {
				...cityData,
				events: cityData.events
					.filter((e) => e.category === catLabel)
					.sort(byScoreThenSoonest),
			};

			paths.push({
				params: { city: citySlug, category: catSlug },
				props: {
					cityData: filteredData,
					allCities: index.cities,
					categorySlug: catSlug,
					categoryLabel: catLabel,
					cityCategories,
				},
			});
		}
	}

	return paths;
}

const { cityData, allCities, categorySlug, categoryLabel, cityCategories } = Astro.props;
const citySlug = Astro.params.city as string;
---

<Base
  cityData={cityData}
  slug={citySlug}
  categorySlug={categorySlug}
  categoryLabel={categoryLabel}
  cityCategories={cityCategories}
>
  <EventApp client:load cityData={cityData} allCities={allCities} />
</Base>
