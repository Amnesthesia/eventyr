---
import "@react/pico.scss";
import "@react/styles.css";
---

<html lang="en" data-theme="auto">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Not found — do things</title>
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0b0b" media="(prefers-color-scheme: dark)" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <!-- Self-hosted (@font-face in app/styles.css, imported above) — this page
         used to pull Inter from fonts.googleapis.com instead, the one place on
         the site still paying for a third-party font chain the rest of the
         site removed. -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/inter-latin.woff2"
      crossorigin
    />
    <script is:inline>
      const t = localStorage.getItem("theme");
      if (t) document.documentElement.setAttribute("data-theme", t);
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to navigation</a>
    <header>
      <a href="/" class="site-name">&gt;&nbsp;do things</a>
      <div class="header-controls">
        <a href="/brisbane/" class="filter-btn">Brisbane</a>
        <a href="/gold-coast/" class="filter-btn">Gold Coast</a>
        <a href="/sunshine-coast/" class="filter-btn">Sunshine Coast</a>
        <a href="/byron/" class="filter-btn">Byron Bay</a>
      </div>
    </header>
    <main id="main">
      <div class="not-found">
        <span class="not-found-code" aria-hidden="true">404</span>
        <h1>Nothing here.</h1>
        <p>This page doesn't exist. Pick a city and find something to do:</p>
        <nav class="not-found-nav" aria-label="Cities">
          <a href="/brisbane/" class="filter-btn active">Brisbane</a>
          <a href="/gold-coast/" class="filter-btn active">Gold Coast</a>
          <a href="/sunshine-coast/" class="filter-btn active">Sunshine Coast</a>
          <a href="/byron/" class="filter-btn active">Byron Bay</a>
        </nav>
      </div>
    </main>
  </body>
</html>

<style is:global>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 4rem 0 2rem;
    gap: 0.6rem;
  }

  .not-found-code {
    font-family: var(--mono);
    font-size: 5rem;
    font-weight: 700;
    line-height: 1;
    color: var(--border);
    letter-spacing: -0.04em;
    margin: 0 0 0.5rem;
  }

  .not-found h1 {
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    margin: 0;
    color: var(--fg);
  }

  .not-found p {
    font-size: var(--t-sm);
    color: var(--muted);
    margin: 0;
  }

  .not-found-nav {
    display: flex;
    gap: 0.5rem;
    margin-top: 1rem;
    flex-wrap: wrap;
  }

  .not-found-nav .filter-btn {
    text-decoration: none;
    font-size: var(--t-2xs);
    height: auto;
    padding: 0.35rem 0.8rem;
  }
</style>
