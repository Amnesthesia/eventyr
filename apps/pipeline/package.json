    "geocode": "tsx --env-file-if-exists=../../.env --tsconfig tsconfig.json src/cli/geocode.ts",
    "markdown": "tsx --env-file-if-exists=../../.env --tsconfig tsconfig.json src/cli/markdown.ts",
    "ical": "tsx --env-file-if-exists=../../.env --tsconfig tsconfig.json src/cli/ical.ts",
    "rss": "tsx --env-file-if-exists=../../.env --tsconfig tsconfig.json src/cli/rss.ts",
